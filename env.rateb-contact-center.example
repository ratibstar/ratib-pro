# =============================================================================
# RATEB — ملف .env للسيرفر (rateb.sa) + Contact Center
# =============================================================================
# ارفع يدوياً إلى:
#   /home/admin/domains/rateb.sa/public_html/.env
#
# cPanel → File Manager → public_html → Upload → اسم الملف: .env
# (إذا موجود .env قديم: Edit ودمج الأسطر أو استبدل فقط قسم Contact Center)
#
# ⚠️ لا ترفع هذا الملف إلى GitHub — فيه كلمات مرور.
# ⚠️ غيّر CHANGE_ME وضع كلمة مرور MySQL الحقيقية من cPanel.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://rateb.sa

# --- MySQL عام (RATEB Pro / fallback) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_rateb
DB_USER=admin_rateb
DB_PASS=CHANGE_ME_MAIN_DB_PASSWORD

RATEB_DB_PREFIX=admin

# --- Control Panel (لوحة التحكم) ---
CONTROL_PANEL_DB_NAME=admin_control_panel_db
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_USER=admin_rateb
CONTROL_DB_PASS=CHANGE_ME_CONTROL_DB_PASSWORD
CONTROL_SITE_URL=https://rateb.sa

# --- RATEB ERP ---
RATEB_PRO_DB_NAME=admin_rateb
RATEB_ERP_DB_NAME=admin_rateb-erp

# =============================================================================
# RATIB Contact Center — مطلوب لـ Inbox API + Agent Desktop + Migrations
# =============================================================================
# cPanel → MySQL® Databases:
#   1) Database: admin_call-center
#   2) User: admin_call-center
#   3) Add User To Database → ALL PRIVILEGES
# =============================================================================

RATIB_CC_DB_NAME=admin_call-center
RATIB_CC_DB_USER=admin_call-center
RATIB_CC_DB_PASS=CHANGE_ME_CALL_CENTER_MYSQL_PASSWORD
RATIB_CC_DB_HOST=127.0.0.1
RATIB_CC_DB_PORT=3306

# alias اختياري (نفس كلمة المرور)
RATEB_CC_DB_PASS=CHANGE_ME_CALL_CENTER_MYSQL_PASSWORD

# =============================================================================
# Realtime — تحديثات لوحة الوكيل (Agent Desktop)
# =============================================================================
# موصى به لـ rateb.sa (استضافة مشتركة): polling — بدون cron وبدون بورت 9702
# =============================================================================

RCC_REALTIME_MODE=polling

# CP username → agent email: admin becomes admin@rateb.sa (override domain if needed)
# RCC_CP_AGENT_EMAIL_DOMAIN=rateb.sa

# إعدادات Hub (احتفظ بها — تُستخدم إذا غيّرت إلى websocket لاحقاً)
RCC_REALTIME_HUB_HOST=127.0.0.1
RCC_REALTIME_HUB_PORT=9701
RCC_WEBSOCKET_HOST=0.0.0.0
RCC_WEBSOCKET_PORT=9702

# --- WebSocket (اختياري — VPS + بورت 9702 مفتوح + cron) ---
# علّق السطر أعلاه polling وفعّل:
# RCC_REALTIME_MODE=websocket
# RCC_WEBSOCKET_PUBLIC_URL=wss://rateb.sa:9702
# RATIB_CC_WS_HOST=rateb.sa
# Cron كل 5 دقائق (cPanel → Cron Jobs):
# */5 * * * * pgrep -f rcc-realtime-hub.php >/dev/null 2>&1 || /bin/bash /home/admin/domains/rateb.sa/public_html/ratib-contact-center/bin/start-realtime-hub.sh

# =============================================================================
# AI Copilot (Phase 7)
# =============================================================================

RCC_AI_ASSISTANT_ENABLED=1
# RCC_AI_PROVIDER=openai

# =============================================================================
# Softphone / SIP — اختياري (عند ربط Asterisk)
# =============================================================================

# RCC_SIP_WSS_URI=wss://pbx.rateb.sa:8089/ws
# RCC_SIP_DOMAIN=pbx.ratib.sa
# RCC_SIP_DEFAULT_PASS=
# RCC_SIP_PASS_TENANT_1=

# =============================================================================
# Asterisk AMI — required for voice worker + PBX commands
# =============================================================================

RCC_AMI_HOST=127.0.0.1
RCC_AMI_PORT=5038
RCC_AMI_USER=rcc
RCC_AMI_PASS=CHANGE_ME_AMI_SECRET

# =============================================================================
# Omnichannel outbound
# =============================================================================

# RCC_WHATSAPP_API_URL=https://graph.facebook.com/v19.0
# RCC_WHATSAPP_PHONE_NUMBER_ID=
# RCC_WHATSAPP_ACCESS_TOKEN=
# RCC_SMTP_HOST=mail.rateb.sa
# RCC_SMTP_PORT=587
# RCC_SMTP_USER=
# RCC_SMTP_PASS=
# RCC_IMAP_HOST=mail.rateb.sa
# RCC_IMAP_USER=
# RCC_IMAP_PASS=

WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET

SYSTEM_MODE=commercial
