# RATEB ERP front controller (cPanel / Apache / LiteSpeed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /rateb-erp/public/

    # Serve existing files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Fallback when mod_rewrite is disabled
<IfModule !mod_rewrite.c>
    FallbackResource /rateb-erp/public/index.php
</IfModule>
