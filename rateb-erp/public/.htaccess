# RATEB ERP — front controller (cPanel / LiteSpeed safe; no RewriteBase, no FallbackResource)
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^favicon\.ico$ favicon.php [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Allow ERP/POS offline SWs to claim the ERP public prefix (not site root).
<FilesMatch "^(pos-sw|rateb-offline-sw)\.js$">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/rateb-erp/public/"
    </IfModule>
</FilesMatch>

Options -Indexes
