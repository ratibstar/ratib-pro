# RATEB ERP — front controller (cPanel / LiteSpeed safe; no RewriteBase, no FallbackResource)
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^favicon\.ico$ favicon.php [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Allow POS offline SW to claim the ERP public prefix (not site root).
<Files "pos-sw.js">
    <IfModule mod_headers.c>
        Header set Service-Worker-Allowed "/rateb-erp/public/"
    </IfModule>
</Files>

Options -Indexes
