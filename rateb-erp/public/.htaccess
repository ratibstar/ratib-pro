# RATEB ERP — front controller (cPanel / LiteSpeed safe; no RewriteBase, no FallbackResource)
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^favicon\.ico$ favicon.php [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

Options -Indexes
