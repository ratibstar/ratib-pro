{
  "schema": "rateb-offline-v2-routes/1",
  "version": "1.0.0-phase5",
  "basePath": "/rateb-erp/public/v2/",
  "defaultRoute": "home",
  "routes": [
    {
      "id": "home",
      "path": "/",
      "title": "Home",
      "handler": "builtin:home"
    },
    {
      "id": "status",
      "path": "/status",
      "title": "Runtime Status",
      "handler": "builtin:status"
    },
    {
      "id": "health",
      "path": "/health",
      "title": "Health",
      "handler": "builtin:health"
    },
    {
      "id": "guarded",
      "path": "/guarded",
      "title": "Guarded",
      "handler": "builtin:guarded",
      "meta": { "requiresFlag": "allowGuarded" }
    }
  ]
}
