# RATEB ERP — Production offline activation profile (example)
# Copy keys into project-root `.env` (gitignored). Do NOT flip defaults in feature-flags.php.
# Kill-switch: RATEB_OFFLINE_ENABLED=0
#
# After enable: migrate 175–194, enroll PIN online once, warm allowlisted ops pages, verify SW.

RATEB_OFFLINE_ENABLED=1
RATEB_OFFLINE_READ_CACHE=1
RATEB_OFFLINE_AUTH_UNLOCK=1
RATEB_OFFLINE_AUTH_COLD=1
RATEB_OFFLINE_RBAC_CACHE=1
RATEB_OFFLINE_MASTER_DATA=1
RATEB_OFFLINE_PILOT_OPS_PAGES=1
RATEB_OFFLINE_MONITORING=1
RATEB_OFFLINE_POS_COMPLETE=1

# Warehouse offline = inventory movements + master_data (no separate offline.warehouse* flag)
RATEB_OFFLINE_INVENTORY_MOVEMENTS=1

RATEB_OFFLINE_HR_ATTENDANCE=1
RATEB_OFFLINE_HR=1
RATEB_OFFLINE_HR_EMPLOYEE=1
RATEB_OFFLINE_HR_TRAINING=1
RATEB_OFFLINE_HR_PERFORMANCE=1
RATEB_OFFLINE_HR_WORKFLOW=1
RATEB_OFFLINE_HR_MASTERDATA=1

RATEB_OFFLINE_PROCUREMENT=1
RATEB_OFFLINE_PROCUREMENT_GRN=1
RATEB_OFFLINE_ACCOUNTING=1
RATEB_OFFLINE_ACCOUNTING_JOURNALS=1
RATEB_OFFLINE_ACCOUNTING_WORKFLOW=1
RATEB_OFFLINE_ACCOUNTING_MASTERDATA=1
RATEB_OFFLINE_CRM=1
RATEB_OFFLINE_CRM_LEADS=1
RATEB_OFFLINE_CRM_WORKFLOW=1
RATEB_OFFLINE_CRM_ACTIVITIES=1
RATEB_OFFLINE_CRM_MASTERDATA=1

# Keep calculate/post/approve paths ONLINE ONLY (enforced in replay services).
# Payroll offline: draft structures only when enabled.
# RATEB_OFFLINE_PAYROLL=1

# Branch hybrid appliance (separate from browser offline):
# RATEB_RUNTIME=branch
# RATEB_HYBRID_SYNC_ENABLED=1
# RATEB_HYBRID_SYNC_SINK=mysql
