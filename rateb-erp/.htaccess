# RATEB ERP folder alias — /rateb-erp/ → front controller under public/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/admin [R=302,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?!public/)(.*)$ public/$1 [L,QSA]
</IfModule>
