# HR Mobile Console (production-safe feature flag)
#
# Default: OFF. When false → menu hidden, /admin/hr-mobile returns 404.
# When true → Super Admin + settings.manage only (no APP_ENV / APP_DEBUG hide).

HR_MOBILE_CONSOLE_ENABLED=false

# Flutter Web base URL (required to launch iframe / new tab)
# RATEB_HR_MOBILE_WEB_URL=https://hrmobile.rateb.sa
# RATEB_HR_MOBILE_WEB_URL=http://localhost:8080

# Optional
# RATEB_HR_MOBILE_API_BASE=
# RATEB_HR_MOBILE_BUILD=0.1.0+1
# RATEB_HR_MOBILE_CONSOLE_ENABLED=true
