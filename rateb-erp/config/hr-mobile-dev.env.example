# HR Mobile Development Console (non-production only)
# Menu appears when APP_ENV|RATEB_ENV is development|dev|local
# OR APP_DEBUG=true (and host is not production-inferred).
# Never when APP_ENV|RATEB_ENV is production|prod.

# APP_ENV=development
# APP_DEBUG=true

# Flutter Web base URL (required to launch preview)
# RATEB_HR_MOBILE_WEB_URL=http://localhost:8080
# RATEB_HR_MOBILE_WEB_URL=https://hrmobile.rateb.sa

# Optional overrides
# RATEB_HR_MOBILE_API_BASE=https://rateb.sa/rateb-erp/public/api/v1
# RATEB_HR_MOBILE_BUILD=0.1.0+1
