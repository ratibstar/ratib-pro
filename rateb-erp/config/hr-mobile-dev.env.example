# HR Mobile Console
#
# Availability flag is NOT controlled by getenv / dotenv.
# Toggle in Admin → Settings → Features (rateb_system_settings.hr_mobile_console_enabled).
# Default: OFF (migration 203 seeds '0').
#
# Optional Flutter Web URL (launch target only — does not show/hide the menu):
# RATEB_HR_MOBILE_WEB_URL=https://hrmobile.rateb.sa
# RATEB_HR_MOBILE_WEB_URL=http://localhost:8080
#
# Optional
# RATEB_HR_MOBILE_API_BASE=
# RATEB_HR_MOBILE_BUILD=0.1.0+1
#
# Legacy (only if DB row missing — prefer Admin Settings):
# HR_MOBILE_CONSOLE_ENABLED=true
# RATEB_HR_MOBILE_CONSOLE_ENABLED=true
