# RATEB Hybrid Runtime — trusted server configuration only
#
# NEVER set these from HTTP, sessions, cookies, or query parameters.
# Cloud hosts: leave RATEB_RUNTIME unset (default = cloud MySQL).
#
# Optional cloud lock (recommended on SaaS / rateb.sa):
#   RATEB_DEPLOYMENT=cloud
#   # or RATEB_CLOUD_LOCK=1
#
# Branch appliance cold start (explicit env approval):
#   RATEB_RUNTIME=branch
#   RATEB_SQLITE_PATH=/absolute/path/to/rateb-branch.sqlite   # optional
#
# Installer-only marker (storage/branch/runtime.mode):
#   Requires BOTH the marker file AND:
#   RATEB_ALLOW_RUNTIME_MARKER=1
# Marker alone NEVER activates branch on cloud.
#
# Phase B local appliance (preferred):
#   php -d extension=pdo_sqlite bin/hybrid-branch-install.php
#   php -d extension=pdo_sqlite bin/hybrid-branch-serve.php
#   (writes storage/branch/serve.env — not used by cloud)
#
# Requires PHP extension: pdo_sqlite (branch only)
#
# RATEB_RUNTIME=branch
# RATEB_SQLITE_PATH=
# RATEB_ALLOW_RUNTIME_MARKER=0
# RATEB_DEPLOYMENT=cloud
#
# ---------------------------------------------------------------------------
# Phase C / C.1 — Hybrid Sync (BRANCH ONLY — never set on cloud)
# ---------------------------------------------------------------------------
# RATEB_HYBRID_SYNC_ENABLED=1
# RATEB_HYBRID_SYNC_SINK=mysql
# RATEB_HYBRID_SYNC_KEY=          # optional HMAC secret; defaults to device hash
# RATEB_HYBRID_SYNC_MIRROR=       # tests only (sink=mirror)
# RATEB_HYBRID_SYNC_PULL_ENTITIES=rateb_plans,rateb_permissions,rateb_warehouses
#
# Always-On service (orchestrates HybridSyncEngine; no business logic):
#   Linux:  deploy/systemd/rateb-hybrid-sync.service
#   Windows: bin/windows/install-hybrid-sync-service.ps1 (WinSW — not Task Scheduler)
#   CLI:    php -d extension=pdo_sqlite -d extension=sqlite3 bin/hybrid-sync-service.php
#
# Phase D — Branch Appliance (cold-start installer):
#   php -d extension=pdo_sqlite -d extension=sqlite3 bin/hybrid-branch-appliance-install.php
#   php bin/hybrid-branch-register.php
#   php bin/hybrid-branch-diagnostics.php
#   php bin/hybrid-branch-certify.php
#