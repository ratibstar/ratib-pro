# RATEB Hybrid Runtime — trusted server configuration only
#
# NEVER set these from HTTP, sessions, cookies, or query parameters.
# Cloud hosts: leave RATEB_RUNTIME unset (default = cloud MySQL).
#
# Optional cloud lock (recommended on SaaS / rateb.sa):
#   RATEB_DEPLOYMENT=cloud
#   # or RATEB_CLOUD_LOCK=1
#
# Branch appliance cold start (explicit env approval):
#   RATEB_RUNTIME=branch
#   RATEB_SQLITE_PATH=/absolute/path/to/rateb-branch.sqlite   # optional
#
# Installer-only marker (storage/branch/runtime.mode):
#   Requires BOTH the marker file AND:
#   RATEB_ALLOW_RUNTIME_MARKER=1
# Marker alone NEVER activates branch on cloud.
#
# Requires PHP extension: pdo_sqlite (branch only)
#
# RATEB_RUNTIME=branch
# RATEB_SQLITE_PATH=
# RATEB_ALLOW_RUNTIME_MARKER=0
# RATEB_DEPLOYMENT=cloud
