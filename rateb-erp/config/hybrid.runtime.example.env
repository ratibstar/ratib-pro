# RATEB Hybrid Runtime — Branch appliance (Phase A+)
#
# Cloud hosts: leave unset (default). MySQL behaviour unchanged.
#
# Branch appliance cold start:
#   RATEB_RUNTIME=branch
#   RATEB_SQLITE_PATH=/absolute/path/to/rateb-branch.sqlite   # optional
#
# Requires PHP extension: pdo_sqlite
#
RATEB_RUNTIME=branch
# RATEB_SQLITE_PATH=
