<?xml version="1.0" encoding="utf-8"?>
<!-- Production App Link + custom scheme for RATEB ERP (sa.rateb.erp).
     Merged into android/app/src/main/AndroidManifest.xml (P1). -->
<intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data
        android:scheme="https"
        android:host="rateb.sa"
        android:pathPrefix="/rateb-erp/public/admin" />
</intent-filter>
<intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="rateberp" android:host="app" />
</intent-filter>
