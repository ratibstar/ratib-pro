<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder Android deep-link intent filter fragment for RATEB ERP.
     Merge into the Activity generated by `npx cap add android`. -->
<intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="https" android:host="YOUR_ERP_HOST" android:pathPrefix="/" />
    <data android:scheme="rateberp" android:host="app" />
</intent-filter>
