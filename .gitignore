# N-Genius / local secrets (never commit)
.env
.env.mobile-unblock
config/ngenius.secrets.php
config/infra.secrets.php
config/env/infra.secrets.php
config/mail.secrets.php
config/env/mail.secrets.php
rateb-erp/config/mail.secrets.php
storage/.rateb_infra_local_secret_key

# Environment variants
.env.*
!.env.example
!.env.ngenius.example

# Dependencies/build artifacts
node_modules/
vendor/
!rateb-erp/public/assets/vendor/
!rateb-erp/public/assets/vendor/**
# Offline V2 runtime SQLite WASM (required on production; not npm install)
!rateb-erp/public/v2/vendor/
!rateb-erp/public/v2/vendor/**
dist/
build/

# Runtime-selected upload root (server-specific; do not commit)
storage/.rateb_effective_upload_root
# Homepage CMS snapshot (generated on control-panel save; server-local)
storage/rateb_site_content_home.json
uploads/rateb_cms_cache/rateb_site_content_home.json
storage/infrastructure-marketplace/runtime-overrides.json
storage/infrastructure-marketplace/runtime-overrides.lock
storage/infrastructure-marketplace/runtime-config-audit.jsonl
storage/infrastructure-marketplace/.rateb_infra_secret_key

# Logs, cache, temp
logs/
*.log
tmp/
temp/
cache/
!/rateb-platform-catalog/app/Infrastructure/Cache/
*.cache

# Archives and dumps
*.zip
*.tar
*.gz
*.sql
!modules/infrastructure-marketplace/Migrations/*.sql
!rateb-erp/migrations/*.sql
!rateb-erp/schema/sqlite/*.sql
!ratib-contact-center/migrations/*.sql
!rateb-platform-catalog/migrations/*.sql
*.sqlite

# Editor/system files
.cursor/
!.cursor/rules/
!.cursor/rules/**
.vscode/
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc
*.pyo

# QA / certification temporary outputs (keep framework, ignore session noise)
scripts/qa-manifest/sessions/regression-output.json
scripts/qa-manifest/sessions/SAFE-QA-PROBE-*.json
docs/v1.0.1/*-local-*.json
rateb-erp/tools/boot-bench/.chrome-user-data/
rateb-erp/tools/boot-bench/reports/*.json

# Generated certification / ops reports (keep committed GA closeout docs)
rateb-erp/docs/GA/go-live-operational-cert-*.json

# Local backup/restore drill artifacts (server paths gitignored via *.gz above)
rateb-erp/storage/backups/*.sql.gz
rateb-erp/storage/backups/*.tar.gz
!rateb-erp/storage/backups/.gitkeep

# Keep Designed folder out of repo operations by default
Designed/

# RATEB Platform Catalog — local binaries & runtime (do not commit)
rateb-platform-catalog/bin/meilisearch.exe
rateb-platform-catalog/bin/*.exe
rateb-platform-catalog/storage/meilisearch/
rateb-platform-catalog/storage/catalog/
rateb-platform-catalog/storage/logs/
rateb-platform-catalog/storage/cache/
rateb-platform-catalog/storage/queue/
rateb-platform-catalog/storage/backups/
rateb-platform-catalog/storage/products/

# Local agent worktree leftovers (must not be committed as gitlinks)
.wt-boot-before/
.wt-*/
