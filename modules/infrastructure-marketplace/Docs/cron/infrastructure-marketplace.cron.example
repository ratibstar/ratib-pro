# Infrastructure Marketplace — suggested cron (cPanel or system crontab)
# Replace /home/admin/public_html with your docroot if different.
# All times UTC; adjust for Riyadh (UTC+3) as needed.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=ops@rateb.sa

# --- Provider health (every 5 minutes) ---
*/5 * * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Cli/provider-health-monitor.php >> /home/admin/logs/infra-health-monitor.log 2>&1

# --- Provider events retention (daily 03:15 UTC) ---
15 3 * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Cli/provider-events-retention.php >> /home/admin/logs/infra-events-retention.log 2>&1

# --- Production verification probe (daily 04:00 UTC) ---
0 4 * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Cli/production-verify.php >> /home/admin/logs/infra-production-verify.log 2>&1

# --- Provisioning worker (continuous — use Supervisor/systemd in production; cron fallback every minute) ---
* * * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Workers/InfrastructureProvisioningWorker.php >> /home/admin/logs/infra-worker.log 2>&1

# --- FUTURE: reconciliation sweep (enable when reconcile CLI is wired) ---
# 0 */6 * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Cli/reconciliation-sweep.php >> /home/admin/logs/infra-reconcile.log 2>&1

# --- FUTURE: dead-letter / queue recovery (see Docs/RUNBOOK_WORKER_QUEUE_RECOVERY.md) ---
# 30 2 * * * cd /home/admin/public_html && /usr/local/bin/php modules/infrastructure-marketplace/Cli/queue-recovery-drill.php --dry-run >> /home/admin/logs/infra-queue-recovery.log 2>&1
