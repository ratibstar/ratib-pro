RewriteEngine On

# Designed storefront: handled only by pages/designed-launcher.php (absolute redirect + HTML fallback). No rewrite — some hosts 500 on this rule.

# Designed app: serve real files; then force ALL /Designed… to public/index.php (even if a Designed/ folder exists on disk)
RewriteCond %{REQUEST_URI} ^/Designed/public/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/Designed(?:/|$) [NC]
RewriteRule ^.*$ public/index.php [L,QSA]

# Company profile — serve about.php (no profile/ folder required on cPanel Fileman).
RewriteRule ^profile$ /profile/ [R=301,L]
RewriteRule ^profile/index\.php$ pages/about.php [L,QSA]
RewriteRule ^profile/$ pages/about.php [L,QSA]
RewriteRule ^pages/profile/?$ /profile/ [R=302,L]

# Security & compliance trust center
RewriteRule ^security-compliance$ /security-compliance/ [R=301,L]
RewriteRule ^security-compliance/$ pages/security-compliance.php [L,QSA]
RewriteRule ^pages/security-compliance/?$ /security-compliance/ [R=302,L]

# Platform architecture (enterprise technical briefing)
RewriteRule ^architecture$ /architecture/ [R=301,L]
RewriteRule ^architecture/$ pages/architecture.php [L,QSA]
RewriteRule ^pages/architecture/?$ /architecture/ [R=302,L]

# Procurement & legal (enterprise buyers)
RewriteRule ^procurement-legal$ /procurement-legal/ [R=301,L]
RewriteRule ^procurement-legal/$ pages/procurement-legal.php [L,QSA]
RewriteRule ^pages/procurement-legal/?$ /procurement-legal/ [R=302,L]

# Enterprise trust hub (procurement-grade pillars)
RewriteRule ^enterprise-trust$ /enterprise-trust/ [R=301,L]
RewriteRule ^enterprise-trust/$ pages/enterprise-trust.php [L,QSA]
RewriteRule ^pages/enterprise-trust/?$ /enterprise-trust/ [R=302,L]

# Government & workforce program operations
RewriteRule ^government-workforce-operations$ /government-workforce-operations/ [R=301,L]
RewriteRule ^government-workforce-operations/$ pages/government-workforce-operations.php [L,QSA]
RewriteRule ^pages/government-workforce-operations/?$ /government-workforce-operations/ [R=302,L]

# Enterprise document packs (print → PDF)
RewriteRule ^enterprise-pack$ /enterprise-pack/ [R=301,L]
RewriteRule ^enterprise-pack/$ pages/enterprise-pack.php [L,QSA]
RewriteRule ^pages/enterprise-pack/?$ /enterprise-pack/ [R=302,L]

# SEO — sitemap & robots at site root
RewriteRule ^sitemap\.xml$ public/sitemap.xml [L]
RewriteRule ^robots\.txt$ public/robots.txt [L]

# Static assets (/css/pages/, /js/pages/, …) — must run before country_slug rewrites (else /css/pages/foo.css → country_slug=css)
RewriteCond %{REQUEST_URI} ^/(css|js|assets|modules|public|uploads)/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Marketing home (MUST be before country-slug catch-all — /home is not a country code)
RewriteRule ^home/?$ pages/home.php [L,QSA]

# Legacy URLs → canonical /profile (THE_REQUEST = browser URL only; avoids internal rewrite loops).
RewriteCond %{THE_REQUEST} \s/+pages/company-profile\.php[\s?] [NC]
RewriteRule ^pages/company-profile\.php$ /profile [R=302,L,QSA]
# Do NOT redirect /pages/about.php → /profile (that caused a loop with profile → about.php).
RewriteCond %{THE_REQUEST} \s/+pages/home\.php[\s?] [NC]
RewriteCond %{QUERY_STRING} (^|&)(open=profile|open=about)(&|$) [NC]
RewriteRule ^pages/home\.php$ /profile [R=302,L]

# Country-specific login: /bangladesh/login, /kenya/login, etc. → /pages/login.php?country_slug=X
RewriteRule ^([a-z0-9_-]+)/login/?$ /pages/login.php?country_slug=$1 [L,QSA]

# Phone barcode scanner (pairs with PC login): /philippines/login-scan?token=…
RewriteRule ^([a-z0-9_-]+)/login-scan/?$ /pages/login-scan.php?country_slug=$1 [L,QSA]

# Country root: /bangladesh, /kenya, etc. → country dashboard route (not /home, /profile, or marketing paths)
RewriteCond %{REQUEST_URI} !^/(control-panel|pages|api|public|Designed|js|css|assets|tap-payments|home|profile|architecture|security-compliance|procurement-legal|enterprise-trust|government-workforce-operations|enterprise-pack)(/|$) [NC]
RewriteRule ^([a-z0-9_-]+)/?$ /pages/dashboard.php?country_slug=$1 [L,QSA]

# Country-prefixed Ratib pages: /philippines/pages/dashboard → /pages/dashboard?country_slug=philippines (QSA keeps control=, agency_id=)
# Must NOT match /control-panel/pages/... or /css/pages/... (css was mistaken for country_slug).
RewriteCond %{REQUEST_URI} !^/control-panel/ [NC]
RewriteCond %{REQUEST_URI} !^/(css|js|assets|modules|public|api|Designed|tap-payments|admin)/ [NC]
RewriteRule ^([a-z0-9_-]+)/pages/(.+?)/?$ /pages/$2?country_slug=$1 [L,QSA]

# Old control panel URLs → new control-panel folder (so bookmarks/links still work)
RewriteCond %{REQUEST_URI} ^/pages/control/ [NC]
RewriteRule ^pages/control/(.*)$ /control-panel/pages/control/$1 [R=302,L,QSA]

# Favicon - serve via PHP to prevent 404
RewriteRule ^favicon\.ico$ favicon.php [L]

# Admin tenant creation page (extensionless URL)
RewriteRule ^admin/create-tenant/?$ /admin/create-tenant.php [L,QSA]
# Admin tenants dashboard (extensionless URL)
RewriteRule ^admin/tenants/?$ /admin/tenants.php [L,QSA]
# Government Control (control panel module)
RewriteRule ^admin/government/?$ /admin/government.php [L,QSA]
# Government tracking read-only dashboard
RewriteRule ^admin/government-tracking/?$ /admin/government-tracking.php [L,QSA]

# Auto-detect: Works for both subdomain root and /reports/ subdirectory
# If files are in /public_html/reports/, uncomment next line:
# RewriteBase /reports/

# ── Extensionless page URLs (hide .php from browsers) ──

# Redirect legacy /pages/home.php → /home (internal serve rule is above country catch-all)
RewriteCond %{THE_REQUEST} \s/+pages/home\.php[\s?] [NC]
RewriteRule ^pages/home\.php$ /home [R=302,L,QSA]

# Browser requested .php under /pages/ → 301 to extensionless (home handled above)
RewriteCond %{THE_REQUEST} \s/+pages/([^\s?]+)\.php[\s?] [NC]
RewriteCond %1 !^home$ [NC]
RewriteRule ^pages/(.+)\.php$ /pages/$1 [R=301,L,QSA]

# Browser requested .php under /control-panel/pages/
RewriteCond %{THE_REQUEST} \s/+control-panel/pages/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^control-panel/pages/(.+)\.php$ /control-panel/pages/$1 [R=301,L,QSA]

# Browser requested country-prefixed .php: /philippines/pages/foo.php → /philippines/pages/foo
RewriteCond %{THE_REQUEST} \s/+([a-z0-9_-]+)/pages/([^\s?]+)\.php[\s?] [NC]
RewriteCond %1 !^(control-panel|pages|api|public|Designed|js|css|assets|tap-payments|admin)$ [NC]
RewriteRule ^([a-z0-9_-]+)/pages/(.+)\.php$ /$1/pages/$2 [R=301,L,QSA]

# Browser requested .php under /admin/ (except rules already defined for specific admin paths)
RewriteCond %{THE_REQUEST} \s/+admin/([^\s?/]+)\.php[\s?] [NC]
RewriteRule ^admin/(.+)\.php$ /admin/$1 [R=301,L,QSA]

# Internal: extensionless /pages/* → *.php when file exists (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/pages/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/pages/%1.php -f
RewriteRule ^pages/(.+?)/?$ pages/$1.php [L,QSA]

# Internal: extensionless /control-panel/pages/* → *.php (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/control-panel/pages/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/control-panel/pages/%1.php -f
RewriteRule ^control-panel/pages/(.+?)/?$ control-panel/pages/$1.php [L,QSA]

# Internal: extensionless /admin/* → *.php (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/admin/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/admin/%1.php -f
RewriteRule ^admin/(.+?)/?$ admin/$1.php [L,QSA]

# Directory index - tells Apache which file to serve
DirectoryIndex public/index.php index.php

# Allow access to public directory files directly
RewriteCond %{REQUEST_URI} ^/public/ [OR]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^ - [L]

# Redirect all other requests to public/index.php except existing files/directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]

# LiteSpeed full-page cache: bare /home served stale Profile→new-tab HTML. Force ?v= at the edge.
RewriteCond %{THE_REQUEST} \s/+home[\s?] [NC]
RewriteCond %{QUERY_STRING} !(^|&)v=
RewriteRule ^home/?$ /home?v=about-enterprise-20260518-profile-same-tab-v6 [R=302,L,QSA]

# LiteSpeed: do not cache marketing home/profile HTML (stale nav after deploy).
<IfModule LiteSpeed>
    CacheDisable public /home
    CacheDisable public /pages/home.php
    CacheDisable public /profile
    CacheDisable public /pages/company-profile.php
    CacheDisable public /pages/about.php
    CacheDisable public /security-compliance
    CacheDisable public /pages/security-compliance.php
    CacheDisable public /architecture
    CacheDisable public /pages/architecture.php
    CacheDisable public /procurement-legal
    CacheDisable public /pages/procurement-legal.php
    CacheDisable public /enterprise-trust
    CacheDisable public /pages/enterprise-trust.php
    CacheDisable public /government-workforce-operations
    CacheDisable public /pages/government-workforce-operations.php
    CacheDisable public /enterprise-pack
    CacheDisable public /pages/enterprise-pack.php
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # Bypass cache for home page + its JS/CSS + program preview SVGs (paths may include subdir installs).
    SetEnvIf Request_URI "/home" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/home\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/about\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/security-compliance" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/security-compliance\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/architecture" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/architecture\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/procurement-legal" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/procurement-legal\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/enterprise-trust" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/enterprise-trust\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/government-workforce-operations" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/government-workforce-operations\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/enterprise-pack" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/enterprise-pack\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/profile" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/company-profile\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "ratib-chrome-bust\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/ratib-which-page\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/pages/ratib-purge-cache\.php" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/home-page\.js" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/about-enterprise\.js" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/home-public\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/about-enterprise\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/security-compliance\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/security-compliance\.js" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/architecture\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/architecture\.js" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/procurement-legal\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/enterprise-trust-layer\.css" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/procurement-legal\.js" RATIB_NOCACHE=1
    SetEnvIf Request_URI "/assets/images/program-preview" RATIB_NOCACHE=1
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private" env=RATIB_NOCACHE
    Header set Pragma "no-cache" env=RATIB_NOCACHE
    Header set Expires "0" env=RATIB_NOCACHE
    Header set Surrogate-Control "no-store" env=RATIB_NOCACHE
</IfModule>

# php_value / php_flag in .htaccess breaks PHP-FPM, LiteSpeed LSAPI, and many cPanel PHP handlers → HTTP 500 for EVERY PHP hit.
# Use cPanel → MultiPHP INI Editor (or .user.ini) for upload_max_filesize, max_execution_time, etc.
# <IfModule mod_php8.c>
#     php_value upload_max_filesize 10M
#     php_value post_max_size 10M
#     php_value max_execution_time 300
#     php_value max_input_time 300
# </IfModule>

# PHP version is controlled by cPanel → MultiPHP Manager (use 8.1+ for Designed).
# Do not add AddHandler application/x-httpd-ea-php74 here — it forces PHP 7.4 and overrides MultiPHP.
