RewriteEngine On

# ── Phase WEBSITE-02 — Agency hosts: / → Website Kernel (never force ERP) ──
# Platform rateb.sa keeps its own marketing rules below.
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/?$ [NC]
RewriteCond %{QUERY_STRING} !(^|&)control=1(&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/rateb-erp/public/index.php -f
RewriteRule ^$ rateb-erp/public/index.php?route=site&rateb_website_kernel=1 [L,QSA]

# Agency: clean /admin → ERP (legacy /rateb-erp/public/admin still works)
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/admin/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/rateb-erp/public/index.php -f
RewriteRule ^admin/?$ rateb-erp/public/index.php?route=admin [L,QSA]
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/admin/(.+)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/admin/%1.php !-f
RewriteCond %{DOCUMENT_ROOT}/rateb-erp/public/index.php -f
RewriteRule ^admin/(.+)$ rateb-erp/public/index.php?route=admin/$1 [L,QSA]

# Agency: public marketing /site + /locale via Website Kernel
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/(site(/.*)?|locale/) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/rateb-erp/public/index.php -f
RewriteRule ^(.*)$ rateb-erp/public/index.php?route=$1&rateb_website_kernel=1 [L,QSA]

# Designed storefront: handled only by pages/designed-launcher.php (absolute redirect + HTML fallback). No rewrite — some hosts 500 on this rule.

# Designed app: serve real files; then force ALL /Designed… to public/index.php (even if a Designed/ folder exists on disk)
RewriteCond %{REQUEST_URI} ^/Designed/public/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} ^/Designed(?:/|$) [NC]
RewriteRule ^.*$ public/index.php [L,QSA]

# Company profile — serve about.php (no profile/ folder required on cPanel Fileman).
RewriteRule ^profile$ /profile/ [R=301,L]
RewriteRule ^profile/index\.php$ pages/about.php [L,QSA]
RewriteRule ^profile/$ pages/about.php [L,QSA]
RewriteRule ^pages/profile/?$ /profile/ [R=302,L]

# Security & compliance trust center
RewriteRule ^security-compliance$ /security-compliance/ [R=301,L]
RewriteRule ^security-compliance/$ pages/security-compliance.php [L,QSA]
RewriteRule ^pages/security-compliance/?$ /security-compliance/ [R=302,L]

# Platform architecture (enterprise technical briefing)
RewriteRule ^architecture$ /architecture/ [R=301,L]
RewriteRule ^architecture/$ pages/architecture.php [L,QSA]
RewriteRule ^pages/architecture/?$ /architecture/ [R=302,L]

# Procurement & legal (enterprise buyers)
RewriteRule ^procurement-legal$ /procurement-legal/ [R=301,L]
RewriteRule ^procurement-legal/$ pages/procurement-legal.php [L,QSA]
RewriteRule ^pages/procurement-legal/?$ /procurement-legal/ [R=302,L]

# Enterprise trust hub (procurement-grade pillars)
RewriteRule ^enterprise-trust$ /enterprise-trust/ [R=301,L]
RewriteRule ^enterprise-trust/$ pages/enterprise-trust.php [L,QSA]
RewriteRule ^pages/enterprise-trust/?$ /enterprise-trust/ [R=302,L]

# Government & workforce program operations
RewriteRule ^government-workforce-operations$ /government-workforce-operations/ [R=301,L]
RewriteRule ^government-workforce-operations/$ pages/government-workforce-operations.php [L,QSA]
RewriteRule ^pages/government-workforce-operations/?$ /government-workforce-operations/ [R=302,L]

# Enterprise document packs (print → PDF)
RewriteRule ^enterprise-pack$ /enterprise-pack/ [R=301,L]
RewriteRule ^enterprise-pack/$ pages/enterprise-pack.php [L,QSA]
RewriteRule ^pages/enterprise-pack/?$ /enterprise-pack/ [R=302,L]

# SEO — sitemap & robots at site root
RewriteRule ^sitemap\.xml$ public/sitemap.xml [L]
RewriteRule ^robots\.txt$ public/robots.txt [L]

# Legacy ERP marketing URLs → canonical /site/* on rateb.sa (not admin/login paths)
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteCond %{THE_REQUEST} \s/+rateb-erp/public/site/([^\s?]+) [NC]
RewriteRule ^rateb-erp/public/site/(.+)$ /site/$1 [R=301,L,QSA]
RewriteCond %{THE_REQUEST} \s/+rateb-erp/public/site/?[\s?] [NC]
RewriteRule ^rateb-erp/public/site/?$ / [R=301,L,QSA]

# rateb.sa — agency registration (standalone page; before ERP marketing at /)
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteCond %{QUERY_STRING} (^|&)open=register(&|$) [NC]
RewriteRule ^$ pages/register-agency.php [L,QSA]

# rateb.sa — ERP marketing site at domain root (Website Kernel)
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/?$ [NC]
RewriteRule ^$ rateb-erp/public/index.php?route=site&rateb_website_kernel=1 [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteCond %{REQUEST_URI} ^/(site(/.*)?|locale/) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ rateb-erp/public/index.php?route=$1&rateb_website_kernel=1 [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteCond %{THE_REQUEST} \s+/site/?[\s?] [NC]
RewriteRule ^site/?$ / [R=301,L]

# Static assets (/css/pages/, /js/pages/, …) — must run before country_slug rewrites (else /css/pages/foo.css → country_slug=css)
RewriteCond %{REQUEST_URI} ^/(css|js|assets|modules|public|uploads)/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Legacy /home deep links → unified marketing home at / (registration uses /pages/agency-request)
RewriteRule ^home/?$ / [R=301,L,QSA]

# App login — MUST be before /{country}/login (otherwise /pages/login → country_slug=pages).
RewriteRule ^pages/login/?$ pages/login.php [L,QSA]
RewriteRule ^login/?$ pages/login.php [L,QSA]

# Control Panel "Open" on agency/test hosts: /?control=1&agency_id=N → login (skip index.php redirect chain).
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteCond %{QUERY_STRING} (^|&)control=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)agency_id=[0-9]+(&|$) [NC]
RewriteRule ^$ pages/login.php [L,QSA]

# Legacy URLs → canonical /profile (THE_REQUEST = browser URL only; avoids internal rewrite loops).
RewriteCond %{THE_REQUEST} \s/+pages/company-profile\.php[\s?] [NC]
RewriteRule ^pages/company-profile\.php$ /profile [R=302,L,QSA]
# Do NOT redirect /pages/about.php → /profile (that caused a loop with profile → about.php).
RewriteCond %{THE_REQUEST} \s/+pages/home\.php[\s?] [NC]
RewriteCond %{QUERY_STRING} (^|&)(open=profile|open=about)(&|$) [NC]
RewriteRule ^pages/home\.php$ /profile [R=302,L]

# Country-specific login: /bangladesh/login, /kenya/login, etc. → /pages/login.php?country_slug=X
RewriteCond %{REQUEST_URI} !^/pages/ [NC]
RewriteRule ^([a-z0-9_-]+)/login/?$ pages/login.php?country_slug=$1 [L,QSA]

# Safety: /ethiopia/rateb-erp/public/... was wrongly built from country site_url — send to real ERP
RewriteCond %{THE_REQUEST} \s/+[a-z0-9_-]+/rateb-erp/public/([^\s?]*) [NC]
RewriteRule ^[a-z0-9_-]+/rateb-erp/public/?(.*)$ /rateb-erp/public/$1 [R=301,L,QSA]

# Country-specific logout: /philippines/logout → pages/logout.php?country_slug=philippines
RewriteCond %{REQUEST_URI} !^/pages/ [NC]
RewriteRule ^([a-z0-9_-]+)/logout/?$ pages/logout.php?country_slug=$1 [L,QSA]

# Phone barcode scanner (pairs with PC login): /philippines/login-scan?token=…
RewriteRule ^([a-z0-9_-]+)/login-scan/?$ /pages/login-scan.php?country_slug=$1 [L,QSA]

# Enterprise QR scanner routes
RewriteRule ^([a-z0-9_-]+)/login/scan/?$ /pages/login-scan.php?country_slug=$1 [L,QSA]
RewriteRule ^([a-z0-9_-]+)/workforce/scan/?$ /pages/login-scan.php?country_slug=$1&mode=checkin [L,QSA]
RewriteRule ^login/scan/?$ /pages/login-scan.php [L,QSA]
RewriteRule ^login/badge/?$ /pages/login-badge.php [L,QSA]
RewriteRule ^workforce/badge/?$ /pages/workforce-badge.php [L,QSA]
RewriteRule ^([a-z0-9_-]+)/login/badge/?$ /pages/login-badge.php?country_slug=$1 [L,QSA]

# Country root: /bangladesh, /kenya, etc. → country dashboard route (not /home, /profile, or marketing paths)
RewriteCond %{REQUEST_URI} !^/(control-panel|rateb-erp|pages|api|public|Designed|js|css|assets|tap-payments|home|profile|architecture|security-compliance|procurement-legal|enterprise-trust|government-workforce-operations|enterprise-pack)(/|$) [NC]
RewriteRule ^([a-z0-9_-]+)/?$ /pages/dashboard.php?country_slug=$1 [L,QSA]

# Country-prefixed RATEB pages: /philippines/pages/dashboard → /pages/dashboard?country_slug=philippines (QSA keeps control=, agency_id=)
# Must NOT match /control-panel/pages/... or /css/pages/... (css was mistaken for country_slug).
RewriteCond %{REQUEST_URI} !^/control-panel/ [NC]
RewriteCond %{REQUEST_URI} !^/(css|js|assets|modules|public|api|Designed|tap-payments|admin)/ [NC]
RewriteRule ^([a-z0-9_-]+)/pages/(.+?)/?$ /pages/$2?country_slug=$1 [L,QSA]

# Old control panel URLs → new control-panel folder (so bookmarks/links still work)
RewriteCond %{REQUEST_URI} ^/pages/control/ [NC]
RewriteRule ^pages/control/(.*)$ /control-panel/pages/control/$1 [R=302,L,QSA]

# Favicon — agency hosts → ERP public handler; main site → root favicon.php
RewriteCond %{HTTP_HOST} ^(www\.)?rateb\.sa$ [NC]
RewriteRule ^favicon\.ico$ favicon.php [L]
RewriteCond %{HTTP_HOST} !^(www\.)?rateb\.sa$ [NC]
RewriteRule ^favicon\.ico$ rateb-erp/public/favicon.php [L]

# Admin tenant creation page (extensionless URL)
RewriteRule ^admin/create-tenant/?$ /admin/create-tenant.php [L,QSA]
# Admin tenants dashboard (extensionless URL)
RewriteRule ^admin/tenants/?$ /admin/tenants.php [L,QSA]
# Government Control (control panel module)
RewriteRule ^admin/government/?$ /admin/government.php [L,QSA]
# Government tracking read-only dashboard
RewriteRule ^admin/government-tracking/?$ /admin/government-tracking.php [L,QSA]

# Auto-detect: Works for both subdomain root and /reports/ subdirectory
# If files are in /public_html/reports/, uncomment next line:
# RewriteBase /reports/

# ── Extensionless page URLs (hide .php from browsers) ──

# Redirect legacy /pages/home.php → unified marketing home (keep registration checkout on /pages/home)
RewriteCond %{THE_REQUEST} \s/+pages/home\.php[\s?] [NC]
RewriteCond %{QUERY_STRING} !(^|&)open=register(&|$) [NC]
RewriteCond %{QUERY_STRING} !(^|&)plan= [NC]
RewriteRule ^pages/home\.php$ / [R=301,L,QSA]

# Browser requested .php under /pages/ → 301 to extensionless (home handled above)
RewriteCond %{THE_REQUEST} \s/+pages/([^\s?]+)\.php[\s?] [NC]
RewriteCond %1 !^home$ [NC]
RewriteRule ^pages/(.+)\.php$ /pages/$1 [R=301,L,QSA]

# Browser requested .php under /control-panel/pages/
RewriteCond %{THE_REQUEST} \s/+control-panel/pages/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^control-panel/pages/(.+)\.php$ /control-panel/pages/$1 [R=301,L,QSA]

# Browser requested country-prefixed .php: /philippines/pages/foo.php → /philippines/pages/foo
RewriteCond %{THE_REQUEST} \s/+([a-z0-9_-]+)/pages/([^\s?]+)\.php[\s?] [NC]
RewriteCond %1 !^(control-panel|pages|api|public|Designed|js|css|assets|tap-payments|admin)$ [NC]
RewriteRule ^([a-z0-9_-]+)/pages/(.+)\.php$ /$1/pages/$2 [R=301,L,QSA]

# Browser requested .php under /admin/ (except rules already defined for specific admin paths)
RewriteCond %{THE_REQUEST} \s/+admin/([^\s?/]+)\.php[\s?] [NC]
RewriteRule ^admin/(.+)\.php$ /admin/$1 [R=301,L,QSA]

# Internal: extensionless /pages/* → *.php when file exists (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/pages/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/pages/%1.php -f
RewriteRule ^pages/(.+?)/?$ pages/$1.php [L,QSA]

# Internal: extensionless /control-panel/pages/* → *.php (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/control-panel/pages/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/control-panel/pages/%1.php -f
RewriteRule ^control-panel/pages/(.+?)/?$ control-panel/pages/$1.php [L,QSA]

# Internal: extensionless /admin/* → *.php (optional trailing slash)
RewriteCond %{REQUEST_URI} ^/admin/(.+?)/?$ [NC]
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/admin/%1.php -f
RewriteRule ^admin/(.+?)/?$ admin/$1.php [L,QSA]

# Directory index - tells Apache which file to serve
DirectoryIndex public/index.php index.php

# Allow access to public directory files directly
RewriteCond %{REQUEST_URI} ^/public/ [OR]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^ - [L]

# RATEB Platform Catalog — static assets
RewriteCond %{REQUEST_URI} ^/rateb-platform-catalog/public/assets/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# RATEB Platform Catalog — front controller (/rateb-platform-catalog/public/…)
RewriteCond %{REQUEST_URI} ^/rateb-platform-catalog/public/ [NC]
RewriteCond %{REQUEST_URI} !^/rateb-platform-catalog/public/index\.php [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rateb-platform-catalog/public/?(.*)$ rateb-platform-catalog/public/index.php?route=$1 [L,QSA]

# RATEB Platform Catalog — folder alias (/rateb-platform-catalog/admin → public/index.php)
RewriteCond %{REQUEST_URI} ^/rateb-platform-catalog/ [NC]
RewriteCond %{REQUEST_URI} !^/rateb-platform-catalog/public/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rateb-platform-catalog/?(.*)$ rateb-platform-catalog/public/index.php?route=$1 [L,QSA]

# RATEB ERP — static assets
RewriteCond %{REQUEST_URI} ^/rateb-erp/public/assets/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# RATIB Contact Center — static assets + API scripts
RewriteCond %{REQUEST_URI} ^/ratib-contact-center/public/asset\.php [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/ratib-contact-center/public/assets/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/ratib-contact-center/public/api/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# RATEB ERP — never use underscore path as HTTP root (DB/IDB names may still use rateb_erp)
RewriteRule ^rateb_erp/public/?(.*)$ /rateb-erp/public/$1 [R=301,L,QSA]
RewriteRule ^rateb_erp/?$ /rateb-erp/public/admin [R=301,L]

# RATEB ERP — folder alias (/rateb-erp/ without /public/)
RewriteRule ^rateb-erp/?$ rateb-erp/public/admin [R=302,L]

# RATEB ERP — utility scripts (legacy 301 may land on /erp-health.php etc.)
RewriteRule ^erp-health\.php$ rateb-erp/public/erp-health.php [L,QSA]

# RATEB ERP — front controller (before site catch-all; pass path as ?route=)
RewriteCond %{REQUEST_URI} ^/rateb-erp/public/ [NC]
RewriteCond %{REQUEST_URI} !^/rateb-erp/public/index\.php [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rateb-erp/public/?(.*)$ rateb-erp/public/index.php?route=$1 [L,QSA]

# Redirect all other requests to public/index.php except existing files/directories
RewriteCond %{REQUEST_URI} !^/rateb-erp/ [NC]
RewriteCond %{REQUEST_URI} !^/rateb-platform-catalog/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]

# LiteSpeed: do not cache unified marketing HTML (/, /site/*, legacy /home redirect).
<IfModule LiteSpeed>
    CacheDisable public /
    CacheDisable public /rateb-erp
    CacheDisable public /rateb-erp/public
    CacheDisable public /erp-health.php
    CacheDisable public /home
    CacheDisable public /site
    CacheDisable public /pages/home.php
    CacheDisable public /pages/register-agency.php
    CacheDisable public /pages/rateb-purge-cache.php
    CacheDisable public /profile
    CacheDisable public /pages/company-profile.php
    CacheDisable public /pages/about.php
    CacheDisable public /security-compliance
    CacheDisable public /pages/security-compliance.php
    CacheDisable public /architecture
    CacheDisable public /pages/architecture.php
    CacheDisable public /procurement-legal
    CacheDisable public /pages/procurement-legal.php
    CacheDisable public /enterprise-trust
    CacheDisable public /pages/enterprise-trust.php
    CacheDisable public /government-workforce-operations
    CacheDisable public /pages/government-workforce-operations.php
    CacheDisable public /enterprise-pack
    CacheDisable public /pages/enterprise-pack.php
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # Bypass cache for unified marketing + legacy home paths.
    SetEnvIf Request_URI "^/$" RATEB_NOCACHE=1
    SetEnvIf Request_URI "^/site" RATEB_NOCACHE=1
    SetEnvIf Request_URI "^/locale/" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/home" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/home\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/about\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/security-compliance" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/security-compliance\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/architecture" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/architecture\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/procurement-legal" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/procurement-legal\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/enterprise-trust" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/enterprise-trust\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/government-workforce-operations" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/government-workforce-operations\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/enterprise-pack" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/enterprise-pack\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/profile" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/company-profile\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "rateb-chrome-bust\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/rateb-which-page\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/pages/rateb-purge-cache\.php" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/home-page\.js" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/about-enterprise\.js" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/home-public\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/about-enterprise\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/security-compliance\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/security-compliance\.js" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/architecture\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/architecture\.js" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/procurement-legal\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/css/pages/enterprise-trust-layer\.css" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/js/pages/procurement-legal\.js" RATEB_NOCACHE=1
    SetEnvIf Request_URI "/assets/images/program-preview" RATEB_NOCACHE=1
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private" env=RATEB_NOCACHE
    Header set Pragma "no-cache" env=RATEB_NOCACHE
    Header set Expires "0" env=RATEB_NOCACHE
    Header set Surrogate-Control "no-store" env=RATEB_NOCACHE
</IfModule>

# php_value / php_flag in .htaccess breaks PHP-FPM, LiteSpeed LSAPI, and many cPanel PHP handlers → HTTP 500 for EVERY PHP hit.
# Use cPanel → MultiPHP INI Editor (or .user.ini) for upload_max_filesize, max_execution_time, etc.
# <IfModule mod_php8.c>
#     php_value upload_max_filesize 10M
#     php_value post_max_size 10M
#     php_value max_execution_time 300
#     php_value max_input_time 300
# </IfModule>

# PHP version is controlled by cPanel → MultiPHP Manager (use 8.1+ for Designed).
# Do not add AddHandler application/x-httpd-ea-php74 here — it forces PHP 7.4 and overrides MultiPHP.
