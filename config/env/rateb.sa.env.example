# =============================================================================
# RATEB — Production .env (rateb.sa ONLY)
# =============================================================================
# Upload manually to:
#   /home/admin/domains/rateb.sa/public_html/.env
#
# cPanel → File Manager → public_html → Upload (or Edit existing .env)
#
# ⚠️ NEVER commit .env to GitHub — contains passwords.
# ⚠️ NEVER put dev.rateb.sa / admin_rateb_dev settings in this file.
#    Staging uses a SEPARATE file: config/env/dev.rateb.sa.env.example
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://rateb.sa
RATEB_ENV=production

# --- MySQL — RATEB Pro (main) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_rateb
DB_USER=admin_rateb
DB_PASS=

RATEB_DB_PREFIX=admin
RATEB_PRO_DB_NAME=admin_rateb

# --- Control Panel ---
CONTROL_PANEL_DB_NAME=admin_control_panel_db
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_USER=admin_rateb
CONTROL_DB_PASS=
CONTROL_SITE_URL=https://rateb.sa

# --- RATEB ERP (production database ONLY) ---
RATEB_ERP_DB_NAME=admin_rateb-erp
RATEB_ERP_DB_USER=admin_rateb
RATEB_ERP_DB_PASS=

# =============================================================================
# RATIB Contact Center
# =============================================================================
# cPanel → MySQL® Databases:
#   Database: admin_call-center
#   User: admin_call-center → ALL PRIVILEGES
# =============================================================================

RATIB_CC_DB_NAME=admin_call-center
RATIB_CC_DB_USER=admin_call-center
RATIB_CC_DB_PASS=
RATIB_CC_DB_HOST=127.0.0.1
RATIB_CC_DB_PORT=3306
RATEB_CC_DB_PASS=

# --- Realtime (shared hosting: polling) ---
RCC_REALTIME_MODE=polling
RCC_REALTIME_HUB_HOST=127.0.0.1
RCC_REALTIME_HUB_PORT=9701
RCC_WEBSOCKET_HOST=0.0.0.0
RCC_WEBSOCKET_PORT=9702

# --- AI Copilot ---
RCC_AI_ASSISTANT_ENABLED=1

# --- Asterisk AMI (optional) ---
RCC_AMI_HOST=127.0.0.1
RCC_AMI_PORT=5038
RCC_AMI_USER=rcc
RCC_AMI_PASS=

# --- RATEB ERP mail ---
RATEB_ERP_SMTP_HOST=mail.rateb.sa
RATEB_ERP_SMTP_PORT=587
RATEB_ERP_SMTP_ENCRYPTION=tls
RATEB_ERP_SMTP_USER=info@rateb.sa
RATEB_ERP_SMTP_FROM_EMAIL=info@rateb.sa
RATEB_ERP_SMTP_FROM_NAME=Rateb ERP
RATEB_ERP_SMTP_PASS=

WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET
SYSTEM_MODE=commercial

# --- Enterprise Accounting Control Center (admin_rateb event store / projections) ---
ACCOUNTING_EVENT_STORE_ENABLED=1
ACCOUNTING_REPLAY_ENABLED=1
ACCOUNTING_AUDIT_ENABLED=1
ACCOUNTING_PROJECTIONS_ENABLED=1
ACCOUNTING_CONSOLIDATION_ENABLED=1
ACCOUNTING_DRIFT_DETECTION_ENABLED=1
ACCOUNTING_INTEGRITY_ENABLED=1
ACCOUNTING_LEDGER_LOCK_ENFORCEMENT_ENABLED=1
ACCOUNTING_CORRECTION_EXECUTOR_ENABLED=1
ACCOUNTING_CORRECTION_AUTO_FIX_ENABLED=0
ACCOUNTING_AUDIT_CERTIFICATION_ENABLED=1
