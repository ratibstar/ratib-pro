# =============================================================================
# RATEB — Staging .env (dev.rateb.sa ONLY)
# =============================================================================
# Upload manually to:
#   /home/admin/domains/dev.rateb.sa/public_html/.env
#
# ⚠️ NEVER use admin_rateb_dev on rateb.sa (production).
# ⚠️ NEVER commit .env to GitHub.
# =============================================================================

APP_ENV=staging
APP_DEBUG=false
APP_URL=https://dev.rateb.sa
RATEB_ENV=staging

# --- MySQL — RATEB Pro (main / control) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_rateb
DB_USER=admin_rateb
DB_PASS=

RATEB_DB_PREFIX=admin
RATEB_PRO_DB_NAME=admin_rateb

# --- Control Panel (optional on staging) ---
CONTROL_PANEL_DB_NAME=admin_control_panel_db
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_USER=admin_rateb
CONTROL_DB_PASS=
CONTROL_SITE_URL=https://dev.rateb.sa

# --- RATEB ERP (staging database ONLY) ---
RATEB_ERP_DB_NAME=admin_rateb_dev
RATEB_ERP_DB_USER=admin_rateb_dev
RATEB_ERP_DB_PASS=

SYSTEM_MODE=commercial
