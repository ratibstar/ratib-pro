APP_ENV=production
APP_DEBUG=false
APP_URL=https://rateb.sa

# DirectAdmin — merged early by config/env/load.php (before config/env/rateb_sa.php)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin_rateb
DB_PASS=
DB_NAME=admin_rateb

RATEB_DB_PREFIX=admin
RATEB_PRO_DB_NAME=admin_rateb
CONTROL_PANEL_DB_NAME=admin_rateb
RATEB_ERP_DB_NAME=admin_rateb-erp

# Keep your existing value from the old .env (do not change unless rotating mobile auth)
MOBILE_AUTH_SECRET=

# Optional: control DB read identity for homepage CMS (usually same as DB_USER above)
# CONTROL_DB_HOST=
# CONTROL_DB_PORT=
# CONTROL_DB_USER=
# CONTROL_DB_PASS=

# Optional: homepage CMS JSON snapshot path
# RATEB_SITE_CONTENT_CACHE_FILE=
# RATEB_SITE_CONTENT_DB_HOST=
# RATEB_SITE_CONTENT_DB_PORT=
# RATEB_SITE_CONTENT_DB_USER=
# RATEB_SITE_CONTENT_DB_PASS=
# RATEB_SITE_CONTENT_DB_NAME=
# RATEB_SITE_CONTENT_DIAG_SECRET=
# RATEB_SITE_CONTENT_PUBLIC_SOURCE=auto
# RATEB_SITE_CONTENT_SKIP_DISK_JSON_CACHE=1

SYSTEM_MODE=commercial

EXTERNAL_API_TOKEN=
EXTERNAL_API_TOKENS=
WEBHOOK_DISPATCH_TOKEN=
WEBHOOK_SIGNING_SECRET=

SEC_RATE_LIMIT_WINDOW_SEC=60
SEC_RATE_LIMIT_IP_MAX=120
SEC_RATE_LIMIT_USER_MAX=240
SEC_EXTERNAL_RATE_LIMIT_WINDOW_SEC=60
SEC_EXTERNAL_RATE_LIMIT_MAX=100
SEC_IP_DENY_LIST=
SEC_IP_ALLOW_LIST=

REQUEST_SIGNING_SECRET=
REQUEST_SIGNING_MAX_SKEW_SEC=300

HEALTH_ACTIVE_WORKFLOWS_WARN=200
HEALTH_WEBHOOK_BACKLOG_WARN=500
HEALTH_FAILURE_RATE_WARN_PCT=20
