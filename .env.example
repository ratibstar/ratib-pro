# =============================================================================
# Rateb — production template (.env.example)
# انسخ إلى .env على السيرفر وعبّئ القيم الفارغة (كلمات المرور والأسرار).
# لا ترفع .env على Git.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://rateb.sa

# --- MySQL رئيسي (RATEB Pro) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=admin_rateb
DB_USER=admin_rateb
DB_PASS=

RATEB_DB_PREFIX=admin
RATEB_PRO_DB_NAME=admin_rateb
RATEB_ERP_DB_NAME=admin_rateb-erp
RATEB_ERP_DB_USER=admin_rateb
RATEB_ERP_DB_PASS=
RATEB_ENV=production

# --- RATEB Platform Catalog (Phase 2.8) ---
# Same MySQL user as ERP is fine if granted on admin_rateb_platform_catalog in DirectAdmin.
# Leave RATEB_PLATFORM_CATALOG_DB_PASS unset to reuse DB_PASS / RATEB_ERP_DB_PASS.
RATEB_PLATFORM_CATALOG_DB_NAME=admin_rateb_platform_catalog
RATEB_PLATFORM_CATALOG_DB_USER=admin_rateb
# RATEB_PLATFORM_CATALOG_DB_PASS=

# --- Control Panel ---
CONTROL_PANEL_DB_NAME=admin_control_panel_db
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_USER=admin_rateb
CONTROL_DB_PASS=
CONTROL_SITE_URL=https://rateb.sa

# --- Mobile portal (JWT) — openssl rand -base64 48 ---
MOBILE_AUTH_SECRET=

# --- API / Webhooks ---
EXTERNAL_API_TOKEN=
EXTERNAL_API_TOKENS=
WEBHOOK_DISPATCH_TOKEN=
WEBHOOK_SIGNING_SECRET=
REQUEST_SIGNING_SECRET=
REQUEST_SIGNING_MAX_SKEW_SEC=300

# --- Rate limiting ---
SEC_RATE_LIMIT_WINDOW_SEC=60
SEC_RATE_LIMIT_IP_MAX=120
SEC_RATE_LIMIT_USER_MAX=240
SEC_EXTERNAL_RATE_LIMIT_WINDOW_SEC=60
SEC_EXTERNAL_RATE_LIMIT_MAX=100
SEC_IP_DENY_LIST=
SEC_IP_ALLOW_LIST=

SYSTEM_MODE=commercial

# --- Health thresholds ---
HEALTH_ACTIVE_WORKFLOWS_WARN=200
HEALTH_WEBHOOK_BACKLOG_WARN=500
HEALTH_FAILURE_RATE_WARN_PCT=20

# --- RATEB Contact Center ---
RATIB_CC_DB_NAME=admin_call-center
RATIB_CC_DB_USER=admin_call-center
RATIB_CC_DB_PASS=
RATIB_CC_DB_HOST=127.0.0.1
RATIB_CC_DB_PORT=3306

RCC_REALTIME_MODE=polling

# إعدادات Hub (احتفظ بها — تُستخدم إذا غيّرت إلى websocket لاحقاً)
RCC_REALTIME_HUB_HOST=127.0.0.1
RCC_REALTIME_HUB_PORT=9701
RCC_WEBSOCKET_HOST=0.0.0.0
RCC_WEBSOCKET_PORT=9702
RCC_AI_ASSISTANT_ENABLED=1

# --- RATEB ERP outbound mail ---
#
# Option A — DirectAdmin mailbox (recommended on same server):
# RATEB_ERP_SMTP_HOST=mail.rateb.sa
# RATEB_ERP_SMTP_USER=info@rateb.sa
# RATEB_ERP_SMTP_PASS=mailbox_password
#
# Option C — SendGrid (recommended relay for Gmail, free tier, port 587):
# https://sendgrid.com → Settings → API Keys → Create → Mail Send
# RATEB_ERP_SMTP_HOST=smtp.sendgrid.net
# RATEB_ERP_SMTP_USER=apikey
# RATEB_ERP_SMTP_PASS=SG.your_api_key
#
# Option D — Mailgun: smtp.mailgun.org | USER=postmaster@mg.rateb.sa
# Option E — Amazon SES: email-smtp.eu-central-1.amazonaws.com (create SMTP creds in SES)
# Option F — Resend: smtp.resend.com | USER=resend | PASS=re_xxx
#
RATEB_ERP_SMTP_HOST=mail.rateb.sa
RATEB_ERP_SMTP_PORT=587
RATEB_ERP_SMTP_ENCRYPTION=tls
RATEB_ERP_SMTP_USER=info@rateb.sa
RATEB_ERP_SMTP_FROM_EMAIL=info@rateb.sa
RATEB_ERP_SMTP_FROM_NAME=Rateb ERP
RATEB_ERP_SMTP_PASS=

# Temporary email diagnostics page under Admin → System → Email Diagnostics.
# Default false. Requires Super Admin + settings.manage permission.
EMAIL_DIAGNOSTICS_ENABLED=false

# --- RATEB ERP Offline (local/pilot activation; defaults OFF in code) ---
# Loaded via config/env/dotenv_bridge.php (RATEB_OFFLINE_* prefix).
# RATEB_OFFLINE_ENABLED=1
# RATEB_OFFLINE_READ_CACHE=1
# RATEB_OFFLINE_AUTH_UNLOCK=1
# RATEB_OFFLINE_AUTH_COLD=1
# RATEB_OFFLINE_RBAC_CACHE=1
# RATEB_OFFLINE_MASTER_DATA=1
# RATEB_OFFLINE_PILOT_OPS_PAGES=1
# RATEB_OFFLINE_MONITORING=1
# RATEB_OFFLINE_IDENTITY_SECRET=
# RATEB_OFFLINE_INVENTORY_MOVEMENTS=1
# RATEB_OFFLINE_HR_ATTENDANCE=1
# RATEB_OFFLINE_HR=1
# RATEB_OFFLINE_PROCUREMENT=1
# RATEB_OFFLINE_CRM=1
# … see rateb-erp/offline/config/feature-flags.php env map for full list
