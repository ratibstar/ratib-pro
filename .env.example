APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

# Merged early by config/env/load.php (before config/env/<host>.php) so out.ratib.sa can override hardcoded fallbacks.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outratib_out
DB_USER=outratib_out
DB_PASS=

# Optional: same names as control-panel/config/env.php. If your tenant DB_USER cannot SELECT ratib_site_content in the control DB,
# set these so pages/home.php reads marketing copy with the same MySQL identity as the control panel (merged before plain DB_*).
# CONTROL_DB_HOST=
# CONTROL_DB_PORT=
# CONTROL_DB_USER=
# CONTROL_DB_PASS=

# Optional: homepage CMS JSON snapshot path if storage/, cache/, and uploads/ratib_cms_cache/ are not writable (absolute or project-relative).
# RATIB_SITE_CONTENT_CACHE_FILE=
#
# Optional: dedicated MySQL login for reading ratib_site_content (control DB). If unset, SINGLE_URL_MODE hosts reuse
# DB_USER against CONTROL_PANEL_DB_NAME (same as agency lookups). See includes/site-content.php.
# RATIB_SITE_CONTENT_DB_HOST=
# RATIB_SITE_CONTENT_DB_PORT=
# RATIB_SITE_CONTENT_DB_USER=
# RATIB_SITE_CONTENT_DB_PASS=
# RATIB_SITE_CONTENT_DB_NAME=
# Optional: random secret — enables GET /api/diagnostics/ratib-site-content-status.php?token=... (DB/json cache health for homepage CMS).
# RATIB_SITE_CONTENT_DIAG_SECRET=
#
# Homepage CMS read mode: on host out.ratib.sa, config/env/out_ratib.sa.php defaults to db_only (MySQL rows + per-key SELECT; no disk JSON/blob fallbacks).
# To restore old behaviour (file + DB snapshot when live SELECT fails), set:
# RATIB_SITE_CONTENT_PUBLIC_SOURCE=auto
# Or only skip JSON files (still allow DB blob snapshot row): RATIB_SITE_CONTENT_SKIP_DISK_JSON_CACHE=1

# Infrastructure Marketplace — encrypted provider secrets + optional provider API keys
# RATIB_INFRA_SECRET_KEY=
# Or copy config/infra.secrets.example.php → config/infra.secrets.php (recommended on cPanel).

SYSTEM_MODE=commercial

EXTERNAL_API_TOKEN=
EXTERNAL_API_TOKENS=
WEBHOOK_DISPATCH_TOKEN=
WEBHOOK_SIGNING_SECRET=

# RATEB Mobile portal — JWT + QR HMAC signing (required on out.ratib.sa)
# Generate: openssl rand -base64 48
MOBILE_AUTH_SECRET=
# Temporary ops only — IP allowlist for /api/mobile/debug-env.php (remove after verify; endpoint deleted)
# MOBILE_ENV_DIAG_IP=YOUR.PUBLIC.IP

SEC_RATE_LIMIT_WINDOW_SEC=60
SEC_RATE_LIMIT_IP_MAX=120
SEC_RATE_LIMIT_USER_MAX=240
SEC_EXTERNAL_RATE_LIMIT_WINDOW_SEC=60
SEC_EXTERNAL_RATE_LIMIT_MAX=100
SEC_IP_DENY_LIST=
SEC_IP_ALLOW_LIST=

REQUEST_SIGNING_SECRET=
REQUEST_SIGNING_MAX_SKEW_SEC=300

HEALTH_ACTIVE_WORKFLOWS_WARN=200
HEALTH_WEBHOOK_BACKLOG_WARN=500
HEALTH_FAILURE_RATE_WARN_PCT=20
